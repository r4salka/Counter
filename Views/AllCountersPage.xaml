<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Counter.Views.AllCountersPage"
    Title="All counters">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <Button
                Text="Add counter"
                Clicked="Add_Clicked" />

            <VerticalStackLayout
                x:Name="CountersLayout"
                Spacing="20">

                <VerticalStackLayout.Resources>

                    <Style TargetType="Label" x:Key="NameStyle">
                        <Setter Property="FontSize" Value="20" />
                        <Setter Property="HorizontalOptions" Value="Center" />
                    </Style>

                    <Style TargetType="Label" x:Key="ValueStyle">
                        <Setter Property="FontSize" Value="40" />
                        <Setter Property="HorizontalOptions" Value="Center" />
                    </Style>

                    <Style TargetType="HorizontalStackLayout" x:Key="ButtonsStyle">
                        <Setter Property="Spacing" Value="15" />
                        <Setter Property="HorizontalOptions" Value="Center" />
                    </Style>

                    <Style TargetType="VerticalStackLayout" x:Key="CounterStyle">
                        <Setter Property="Spacing" Value="5" />
                    </Style>

                </VerticalStackLayout.Resources>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>