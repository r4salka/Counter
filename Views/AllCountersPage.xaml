<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Counter.Views.AllCountersPage"
    xmlns:models ="clr-namespace:Counter.Models"
    x:DataType="models:AllCounters"
    Title="All counters">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{Binding AddButtonText}"
                 Clicked="Add_Clicked"
                 IconImageSource="{FontImageSource Glyph='+', Color='Black', Size=22}"/>
    </ContentPage.ToolbarItems>

    <CollectionView
    x:Name="countersCollection"
    ItemsSource="{Binding Counters}"
    Margin="20"
    SelectionMode="Single"
    SelectionChanged="countersCollection_SelectionChanged">

        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical"
                           ItemSpacing="10"/>
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Counter">
                <StackLayout>
                    <Label Text="{Binding Name}" 
                       FontSize="22"/>
                    <Label Text="{Binding Value}" 
                       FontSize="14"
                       TextColor="Silver"/>
                </StackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>